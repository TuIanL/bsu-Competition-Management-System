<view class="form">
  <view class="field">
    <text class="field-label">原密码</text>
    <input class="field-input" password placeholder="当前使用的密码" placeholder-class="placeholder"
           data-field="old_password" bindinput="onInput" />
  </view>
  <view class="field">
    <text class="field-label">新密码</text>
    <input class="field-input" password placeholder="至少 6 位" placeholder-class="placeholder"
           data-field="new_password" bindinput="onInput" />
  </view>
  <view class="field">
    <text class="field-label">确认新密码</text>
    <input class="field-input" password placeholder="再输入一次" placeholder-class="placeholder"
           data-field="confirm" bindinput="onInput" />
  </view>
</view>
<view class="field-hint">志愿者初始密码是学号后六位，建议首次登录后修改。忘记密码可请组委会重置。</view>
<view class="form-actions">
  <view class="btn btn-block {{submitting ? 'btn-off' : ''}}" hover-class="btn-hover" bindtap="submit">保存新密码</view>
</view>
